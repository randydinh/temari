{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed sanitized input packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "notice",
    "caseOrder",
    "productIntentSources",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureId": {
      "const": "qa-upper110-fixed-inputs-v1"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "caseOrder": {
      "const": [
        "case-01",
        "case-02",
        "case-03",
        "case-04",
        "case-05",
        "case-06"
      ]
    },
    "productIntentSources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "authority",
          "approval",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "sessionMessages",
          "input"
        ],
        "properties": {
          "id": {
            "enum": [
              "case-01",
              "case-02",
              "case-03",
              "case-04",
              "case-05",
              "case-06"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "sessionMessages": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "const": "user"
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "input": {
            "type": "object"
          }
        }
      }
    }
  }
}
