{
  "name": "@temari/workflow-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "workflow-runtime",
    "tags": [
      "scope:workflow",
      "type:distribution"
    ],
    "targets": {
      "guided-setup-test": {
        "command": "node --test packages/workflow-runtime/unified/hosts.test.mjs packages/workflow-runtime/unified/clients.test.mjs packages/workflow-runtime/unified/guide.test.mjs packages/workflow-runtime/unified/providers.test.mjs packages/workflow-runtime/unified/project.test.mjs",
        "cache": false
      },
      "unified-assets-test": {
        "command": "node --test tools/unified-assets.test.mjs tools/unified-provider-assets.test.mjs",
        "cache": false
      },
      "unified-test": {
        "command": "node --test tools/unified-release.test.mjs",
        "cache": false
      },
      "unified-package": {
        "command": "node tools/unified-release.mjs",
        "cache": false
      },
      "privacy-generate": {
        "command": "node tools/generate-privacy-runtime.mjs --write",
        "cache": false
      },
      "privacy-check": {
        "command": "node tools/generate-privacy-runtime.mjs --check",
        "cache": false
      },
      "privacy-test": {
        "command": "node --test tools/generate-privacy-runtime.test.mjs && bun test tools/privacy-adapter.test.mjs",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "privacy-native-test": {
        "command": "node --import @swc-node/register/esm-register tools/run-privacy-native-tests.mjs",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "privacy-preflight": {
        "command": "node --import @swc-node/register/esm-register tools/privacy-preflight.mjs",
        "cache": false
      },
      "test": {
        "command": "node --import @swc-node/register/esm-register --test packages/workflow-runtime/src/lib/workflow-runtime.test.ts",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": true
      },
      "package": {
        "command": "node --import @swc-node/register/esm-register packages/workflow-runtime/src/cli.ts package",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "check": {
        "command": "node --import @swc-node/register/esm-register packages/workflow-runtime/src/cli.ts check",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "canonical-package": {
        "command": "node tools/canonical-runtime.mjs package",
        "cache": false
      },
      "canonical-check": {
        "command": "node tools/canonical-runtime.mjs check",
        "cache": false
      },
      "canonical-test": {
        "command": "node --test tools/canonical-runtime.test.mjs",
        "cache": false
      },
      "host-session-test": {
        "command": "node --test tools/host-session.test.mjs",
        "cache": false
      },
      "host-entry": {
        "command": "node packages/workflow-runtime/host/entry.mjs",
        "cache": false
      },
      "public-entry-test": {
        "command": "node --test tools/pstack-method-library.test.mjs tools/public-entry-runtime.test.mjs",
        "cache": false
      },
      "knowledge-area-test": {
        "command": "node --test tools/knowledge-areas.test.mjs",
        "cache": false
      },
      "public-package": {
        "command": "node tools/public-entry-runtime.mjs package",
        "cache": false
      },
      "public-check": {
        "command": "node tools/public-entry-runtime.mjs check",
        "cache": false
      },
      "qa-installed-journey": {
        "command": "node tools/qa-installed-journey.mjs",
        "cache": false
      },
      "qa-policy-semantic-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/qa-temari-policy-semantic.test.mjs",
        "cache": false
      },
      "qa-real-policy-journey": {
        "command": "node tools/qa-real-policy-journey.mjs",
        "cache": false
      },
      "qa-public-package": {
        "command": "node tools/public-entry-runtime.mjs package",
        "cache": false
      },
      "knowledge-plugin-package": {
        "command": "node tools/knowledge-plugin.mjs package",
        "cache": false
      },
      "knowledge-plugin-test": {
        "command": "node --test tools/knowledge-plugin.test.mjs",
        "cache": false
      },
      "knowledge-release-test": {
        "command": "node --test tools/knowledge-release.test.mjs",
        "cache": false
      },
      "knowledge-release-package": {
        "command": "node tools/knowledge-release.mjs package",
        "cache": false
      },
      "knowledge-private-install-test": {
        "command": "node --test tools/knowledge-private-install.test.mjs",
        "cache": false
      },
      "nx06-safety-test": {
        "command": "node --test tools/nx06-safety.test.mjs",
        "cache": false
      },
      "canonical-bridge-test": {
        "command": "bun test packages/workflow-runtime/assets/v4.1/integrations/archon/canonical-bridge.test.ts",
        "cache": false
      },
      "archon-lifecycle-test": {
        "command": "bun test packages/workflow-runtime/assets/v4.1/integrations/archon/lifecycle.test.ts",
        "cache": false
      },
      "qa-capability-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/qa-capability.test.mjs",
        "cache": false
      },
      "communication-fixtures-test": {
        "command": "node tools/check-communication-fixtures.mjs corpus && node --test tools/check-communication-fixtures.test.mjs",
        "cache": false
      },
      "communication-fixtures-review": {
        "command": "node tools/check-communication-fixtures.mjs review evaluations/communication/review.json",
        "cache": false
      },
      "communication-bundle-test": {
        "command": "node --test --test-name-pattern=\"packages an isolated relocated outer bundle|both engineering skills reach shared conversation guidance\" tools/public-entry-runtime.test.mjs",
        "cache": false
      },
      "pinned-submodules-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-isolation=none tools/pinned-submodules.test.mts tools/run-codex-write-workers.test.mts tools/run-codex-parallel.test.mts libs/runtime/src/lib/candidate.test.ts libs/contracts/src/lib/workflow-receipt.test.ts"
        }
      },
      "pinned-submodules-package-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test --test-name-pattern=\"packages an isolated relocated|full feature|feature host proof|packaged closeout|host forge gate|relocated public bundle routes\" tools/public-entry-runtime.test.mjs"
        }
      },
      "pinned-submodules-typecheck": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck tools/pinned-submodules.mts tools/pinned-submodules.test.mts tools/run-codex-write-workers.mts tools/run-codex-write-workers.test.mts"
        }
      },
      "release-package": {
        "command": "node tools/temari-release.mjs package",
        "cache": false
      },
      "release-check": {
        "command": "node tools/temari-release.mjs check",
        "cache": false
      },
      "release-test": {
        "command": "node --test tools/temari-release.test.mjs",
        "cache": false
      },
      "install-state": {
        "command": "node tools/temari-install-state.mjs",
        "cache": false
      },
      "install-state-test": {
        "command": "node --test tools/temari-install-state.test.mjs",
        "cache": false
      },
      "installed-journey": {
        "command": "node tools/temari-installed-journey.mjs",
        "cache": false
      },
      "managed-candidate-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/reviewed-local-candidate.test.mjs",
        "cache": false
      },
      "managed-resource-test": {
        "command": "node --test --test-name-pattern=\"packages an isolated relocated outer bundle|relocated managed resources\" tools/public-entry-runtime.test.mjs",
        "cache": false
      },
      "managed-shutdown-test": {
        "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/managed-shutdown.test.mts",
        "cache": false
      },
      "managed-shutdown-typecheck": {
        "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck --allowImportingTsExtensions tools/managed-shutdown.test.mts tools/fixtures/managed-execution-controller.mts tools/managed-candidate-operation.mts tools/fixtures/owned-execution-bun.mts tools/managed-shutdown-r1.test.mts",
        "cache": false
      },
      "managed-cancel-intent-test": {
        "command": "node --import @swc-node/register/esm-register --test --test-name-pattern=\"parent cancel intent|worker lease loss\" tools/reviewed-local-candidate.test.mjs",
        "cache": false
      },
      "managed-shutdown-r1-test": {
        "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/managed-shutdown-r1.test.mts libs/runtime/src/lib/child-task-store.test.ts libs/runtime/src/lib/task-store.test.ts libs/runtime/src/lib/task-runtime.test.ts",
        "cache": false
      },
      "unified-recipient-smoke": {
        "command": "node tools/unified-recipient-smoke.mjs",
        "cache": false
      },
      "unified-platform-check": {
        "command": "node tools/unified-platform-check.mjs",
        "cache": false
      }
    }
  },
  "dependencies": {}
}
