{
  "name": "@temari/workflow-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "workflow-runtime",
    "tags": [
      "scope:workflow",
      "type:distribution"
    ],
    "targets": {
      "privacy-generate": {
        "command": "node tools/generate-privacy-runtime.mjs --write",
        "cache": false
      },
      "privacy-check": {
        "command": "node tools/generate-privacy-runtime.mjs --check",
        "cache": false
      },
      "privacy-test": {
        "command": "node --test tools/generate-privacy-runtime.test.mjs && bun test tools/privacy-adapter.test.mjs",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "privacy-native-test": {
        "command": "node --import @swc-node/register/esm-register tools/run-privacy-native-tests.mjs",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "privacy-preflight": {
        "command": "node --import @swc-node/register/esm-register tools/privacy-preflight.mjs",
        "cache": false
      },
      "test": {
        "command": "node --import @swc-node/register/esm-register --test packages/workflow-runtime/src/lib/workflow-runtime.test.ts",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": true
      },
      "package": {
        "command": "node --import @swc-node/register/esm-register packages/workflow-runtime/src/cli.ts package",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "check": {
        "command": "node --import @swc-node/register/esm-register packages/workflow-runtime/src/cli.ts check",
        "dependsOn": [
          "privacy-check"
        ],
        "cache": false
      },
      "canonical-package": {
        "command": "node tools/canonical-runtime.mjs package",
        "cache": false
      },
      "canonical-check": {
        "command": "node tools/canonical-runtime.mjs check",
        "cache": false
      },
      "canonical-test": {
        "command": "node --test tools/canonical-runtime.test.mjs",
        "cache": false
      },
      "host-session-test": {
        "command": "node --test tools/host-session.test.mjs",
        "cache": false
      },
      "host-entry": {
        "command": "node packages/workflow-runtime/host/entry.mjs",
        "cache": false
      },
      "public-entry-test": {
        "command": "node --test tools/public-entry-runtime.test.mjs",
        "cache": false
      },
      "qa-installed-journey": {
        "command": "node tools/qa-installed-journey.mjs",
        "cache": false
      },
      "qa-policy-semantic-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/qa-temari-policy-semantic.test.mjs",
        "cache": false
      },
      "qa-real-policy-journey": {
        "command": "node tools/qa-real-policy-journey.mjs",
        "cache": false
      },
      "qa-public-package": {
        "command": "node tools/public-entry-runtime.mjs package",
        "cache": false
      },
      "knowledge-plugin-package": {
        "command": "node tools/knowledge-plugin.mjs package",
        "cache": false
      },
      "knowledge-plugin-test": {
        "command": "node --test tools/knowledge-plugin.test.mjs",
        "cache": false
      },
      "knowledge-release-test": {
        "command": "node --test tools/knowledge-release.test.mjs",
        "cache": false
      },
      "knowledge-release-package": {
        "command": "node tools/knowledge-release.mjs package",
        "cache": false
      },
      "knowledge-private-install-test": {
        "command": "node --test tools/knowledge-private-install.test.mjs",
        "cache": false
      },
      "nx06-safety-test": {
        "command": "node --test tools/nx06-safety.test.mjs",
        "cache": false
      },
      "canonical-bridge-test": {
        "command": "bun test packages/workflow-runtime/assets/v4.1/integrations/archon/canonical-bridge.test.ts",
        "cache": false
      },
      "archon-lifecycle-test": {
        "command": "bun test packages/workflow-runtime/assets/v4.1/integrations/archon/lifecycle.test.ts",
        "cache": false
      },
      "qa-capability-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/qa-capability.test.mjs",
        "cache": false
      },
      "communication-fixtures-test": {
        "command": "node tools/check-communication-fixtures.mjs corpus && node --test tools/check-communication-fixtures.test.mjs",
        "cache": false
      },
      "communication-fixtures-review": {
        "command": "node tools/check-communication-fixtures.mjs review evaluations/communication/review.json",
        "cache": false
      },
      "communication-bundle-test": {
        "command": "node --test --test-name-pattern=\"packages an isolated relocated outer bundle|both engineering skills reach shared conversation guidance\" tools/public-entry-runtime.test.mjs",
        "cache": false
      },
      "pinned-submodules-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-isolation=none tools/pinned-submodules.test.mts tools/run-codex-write-workers.test.mts tools/run-codex-parallel.test.mts libs/runtime/src/lib/candidate.test.ts libs/contracts/src/lib/workflow-receipt.test.ts"
        }
      },
      "pinned-submodules-package-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --test --test-name-pattern=\"packages an isolated relocated|full feature|feature host proof|packaged closeout|host forge gate|relocated public bundle routes\" tools/public-entry-runtime.test.mjs"
        }
      },
      "pinned-submodules-typecheck": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck tools/pinned-submodules.mts tools/pinned-submodules.test.mts tools/run-codex-write-workers.mts tools/run-codex-write-workers.test.mts"
        }
      },
      "managed-candidate-test": {
        "command": "node --import @swc-node/register/esm-register --test tools/reviewed-local-candidate.test.mjs",
        "cache": false
      }
    }
  },
  "dependencies": {}
}
