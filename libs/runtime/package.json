{
  "name": "@temari/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "runtime",
    "tags": [
      "scope:core",
      "type:runtime"
    ],
    "targets": {
      "tasks": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register tools/task-continuity.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "task-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/runtime/src/lib/task-store.test.ts libs/runtime/src/lib/task-runtime.test.ts tools/task-view.test.mts tools/task-continuity.test.mts tools/dashboard-controller.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "task-typecheck": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "typecheck"
        ],
        "options": {
          "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck tools/task-view.mts tools/task-continuity.mts tools/task-view.test.mts tools/task-continuity.test.mts tools/task-native.test.mts tools/dashboard-controller.mts tools/dashboard-controller.test.mts tools/dashboard-swarm.mts tools/dashboard-swarm.test.mts tools/dashboard-native.test.mts tools/dashboard-implementation.mts tools/dashboard-implementation.test.mts tools/dashboard-planner.mts tools/dashboard-planner.test.mts tools/dashboard-scheduler.mts tools/dashboard-scheduler.test.mts tools/dashboard-knowledge.mts tools/dashboard-knowledge.test.mts tools/dashboard-open-work.mts tools/dashboard-open-work.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "task-native-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/task-native.test.mts tools/dashboard-native.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/runtime/src/lib/runtime.test.ts libs/runtime/src/lib/run-store.test.ts libs/runtime/src/lib/child-task-store.test.ts libs/runtime/src/lib/parallel-runtime.test.ts libs/runtime/src/lib/harness-selector.test.ts libs/runtime/src/lib/harness-runtime.test.ts libs/runtime/src/lib/archon-receipt-parity.test.ts libs/runtime/src/lib/v4-1-route-replay.test.ts libs/runtime/src/lib/migration-acceptance.test.ts libs/runtime/src/lib/stage-evidence.test.ts libs/runtime/src/lib/candidate.test.ts libs/runtime/src/lib/nx05-control-conformance.test.ts libs/runtime/src/lib/nx05-dispatch-contract.test.ts libs/runtime/src/lib/task-store.test.ts libs/runtime/src/lib/task-runtime.test.ts libs/runtime/src/lib/merge-reconciliation-store.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "migration-acceptance": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/migration-acceptance.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "nx05-control-conformance": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/nx05-control-conformance.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "nx05-dispatch-contract": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/nx05-dispatch-contract.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-controller.test.mts tools/dashboard-swarm.test.mts tools/merge-reconciliation-dashboard.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-native-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-native.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-worker-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/runtime/src/lib/parallel-runtime.test.ts libs/runtime/src/lib/stage-evidence.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-implementation-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-implementation.test.mts tools/run-codex-write-workers.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-planner-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-planner.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "dashboard-schedule-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/runtime/src/lib/schedule-store.test.ts tools/dashboard-scheduler.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "knowledge-map-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-knowledge.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "open-work-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 tools/dashboard-open-work.test.mts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@temari/contracts": "workspace:*",
    "@temari/temari-core": "workspace:^",
    "@temari/workflow-engine": "workspace:*"
  }
}
