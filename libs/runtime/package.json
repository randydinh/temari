{
  "name": "@temari/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "runtime",
    "tags": [
      "scope:core",
      "type:runtime"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/runtime/src/lib/runtime.test.ts libs/runtime/src/lib/run-store.test.ts libs/runtime/src/lib/child-task-store.test.ts libs/runtime/src/lib/parallel-runtime.test.ts libs/runtime/src/lib/harness-selector.test.ts libs/runtime/src/lib/harness-runtime.test.ts libs/runtime/src/lib/archon-receipt-parity.test.ts libs/runtime/src/lib/v4-1-route-replay.test.ts libs/runtime/src/lib/migration-acceptance.test.ts libs/runtime/src/lib/stage-evidence.test.ts libs/runtime/src/lib/candidate.test.ts libs/runtime/src/lib/nx05-control-conformance.test.ts libs/runtime/src/lib/nx05-dispatch-contract.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "migration-acceptance": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/migration-acceptance.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "nx05-control-conformance": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/nx05-control-conformance.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "nx05-dispatch-contract": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/runtime/src/lib/nx05-dispatch-contract.test.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@temari/contracts": "workspace:*",
    "@temari/temari-core": "workspace:^",
    "@temari/workflow-engine": "workspace:*"
  }
}
