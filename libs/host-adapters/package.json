{
  "name": "@temari/host-adapters",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "host-adapters",
    "tags": [
      "scope:host",
      "type:adapter"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/host-adapters/src/lib/host-adapters.test.ts libs/host-adapters/src/lib/codex-exec-worker.test.ts libs/host-adapters/src/lib/live-doctor.test.ts libs/host-adapters/src/lib/codex-model-driver.test.ts libs/host-adapters/src/lib/model-transport.test.ts libs/host-adapters/src/lib/openai-responses-driver.test.ts libs/host-adapters/src/lib/ollama-model-driver.test.ts libs/host-adapters/src/lib/git-reconciliation-observer.test.ts tools/run-codex-workers.test.mts tools/run-codex-write-workers.test.mts tools/pinned-submodules.test.mts tools/run-codex-parallel.test.mts tools/run-qa-benny-local.test.mjs libs/host-adapters/src/lib/privacy-decision-host.test.ts libs/host-adapters/src/lib/process-capture.test.ts libs/host-adapters/src/lib/scoped-worker-tools.test.ts libs/host-adapters/src/lib/worker-execution.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "local-ollama-canary": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register tools/ollama-protected-canary.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "diagnostics-test": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/host-adapters/src/lib/process-capture.test.ts libs/host-adapters/src/lib/codex-exec-worker.test.ts tools/run-codex-workers.test.mts tools/run-codex-write-workers.test.mts",
          "cwd": "{workspaceRoot}"
        }
      },
      "ollama-test": {
        "command": "node --import @swc-node/register/esm-register --test libs/host-adapters/src/lib/ollama-model-driver.test.ts",
        "cache": false
      },
      "worker-execution-test": {
        "command": "node --import @swc-node/register/esm-register --test --test-concurrency=1 libs/host-adapters/src/lib/scoped-worker-tools.test.ts libs/host-adapters/src/lib/worker-execution.test.ts",
        "cache": false
      },
      "worker-execution-typecheck": {
        "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck libs/host-adapters/src/lib/worker-execution.ts libs/host-adapters/src/lib/scoped-worker-tools-stdio.ts libs/host-adapters/src/lib/worker-execution.test.ts libs/host-adapters/src/lib/scoped-worker-tools.test.ts",
        "cache": false
      }
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@temari/contracts": "workspace:*",
    "@temari/privacy": "workspace:*",
    "@temari/temari-core": "workspace:^",
    "zod": "3.25.76"
  }
}
