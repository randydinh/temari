{
  "name": "@temari/knowledge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "knowledge",
    "targets": {
      "test": { "executor": "nx:run-commands", "options": {
        "command": "node --import @swc-node/register/esm-register --test libs/knowledge/src/lib/knowledge.test.ts",
        "cwd": "{workspaceRoot}"
      } },
      "integration": { "executor": "nx:run-commands", "cache": false, "options": {
        "command": "node --import @swc-node/register/esm-register --test libs/knowledge/src/lib/registrar.integration.test.ts",
        "cwd": "{workspaceRoot}"
      } },
      "demo": { "executor": "nx:run-commands", "options": {
        "command": "node --import @swc-node/register/esm-register libs/knowledge/src/demo.ts",
        "cwd": "{workspaceRoot}"
      } }
    }
  },
  "dependencies": { "@temari/contracts": "workspace:*" },
  "devDependencies": { "@temari/workflow-engine": "workspace:*" }
}
