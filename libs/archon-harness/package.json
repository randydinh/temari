{
  "name": "@temari/archon-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "archon-harness",
    "tags": [
      "scope:platform",
      "type:adapter"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/archon-harness/src/lib/managed-runtime.test.ts libs/archon-harness/src/lib/archon-harness.test.ts libs/archon-harness/src/lib/canonical-finalize.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "canonical-native-journey": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/archon-harness/src/lib/canonical-native.test.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "identity-initialization-typecheck": {
        "command": "tsc --ignoreConfig --noEmit --module nodenext --moduleResolution nodenext --target es2022 --types node --strict --skipLibCheck --allowImportingTsExtensions libs/archon-harness/src/lib/archon-harness.test.ts",
        "cache": false
      }
    }
  },
  "dependencies": {
    "@temari/contracts": "workspace:*",
    "@temari/runtime": "workspace:^"
  }
}
