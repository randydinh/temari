{
  "name": "@temari/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "contracts",
    "tags": [
      "scope:core",
      "type:contracts"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --import @swc-node/register/esm-register --test libs/contracts/src/lib/worker.test.ts libs/contracts/src/lib/capabilities.test.ts libs/contracts/src/lib/v4-1-compatibility.test.ts libs/contracts/src/lib/merge-reconciliation.test.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {}
}
