        {
          "id": "feature.shape.how",
          "sourceStep": "1",
          "description": "Run how over the affected subsystem.",
          "allowedEvidenceKinds": ["document", "review"],
          "skip": { "allowed": false }
        }
      ]
    },
    {
      "id": "build",
      "assignment": { "owner": "non-coordinator", "distinctFrom": ["review"] },
      "requirements": [
